{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|manifest\\.json|assets\\/).*)",
      "destination": "/index.html"
    }
  ]
}
